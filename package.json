{
  "name": "vrt-android-utils",
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic Android emulator setup for local development and CI",
  "author": "troZee",
  "bin": {
    "vrt-emulator": "src/cli.mjs"
  },
  "files": [
    "src",
    "emulator.config.example.json",
    "emulator.config.schema.json"
  ],
  "scripts": {
    "format": "oxfmt \"**/*.mjs\"",
    "format:check": "oxfmt --check \"**/*.mjs\"",
    "lint": "eslint \"**/*.mjs\"",
    "test": "bun test",
    "validate": "node src/cli.mjs validate",
    "package:check": "node scripts/check-package.mjs",
    "check": "bun run format:check && bun run lint && bun test && bun run package:check",
    "prepublishOnly": "bun run check"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "android",
    "emulator",
    "avd",
    "visual-regression-testing",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/troZee/vrt-android-utils.git"
  },
  "bugs": {
    "url": "https://github.com/troZee/vrt-android-utils/issues"
  },
  "homepage": "https://github.com/troZee/vrt-android-utils#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "bun@1.4.0",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "oxfmt": "^0.68.0"
  }
}
